// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION_BOOKED
  PROPOSAL_SENT
  WON
  LOST
  NURTURE
}

enum ClientType {
  INDIVIDUAL
  FAMILY
  CORPORATE
  PARTNER
}

enum ConsentStatus {
  PENDING
  GRANTED
  WITHDRAWN
}

enum CaseStatus {
  ENQUIRY
  CONSULTATION
  CLIENT_ONBOARDING
  DOCUMENTS_REQUESTED
  DOCUMENTS_RECEIVED
  UNDER_REVIEW
  CORRECTIONS_REQUIRED
  READY_FOR_SUBMISSION
  SUBMITTED
  AWAITING_DECISION
  APPROVED
  REFUSED
  WITHDRAWN
  CLOSED
}

enum CaseOutcome {
  APPROVED
  REFUSED
  WITHDRAWN
  PENDING
  OTHER
}

enum RequirementStatus {
  MANDATORY
  CONDITIONAL
  OPTIONAL
  NOT_APPLICABLE
}

enum ChecklistItemStatus {
  NOT_REQUESTED
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REPLACEMENT_REQUESTED
  EXPIRED
  SUPERSEDED
}

enum DocSensitivity {
  NORMAL
  SENSITIVE
  HIGHLY_SENSITIVE
}

enum DocStatus {
  DRAFT
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CORRECTION
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  BLOCKED
}

enum TaskType {
  INTERNAL
  CLIENT
  SYSTEM
  FOLLOW_UP
  DOCUMENT_REQUEST
  APPOINTMENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum Channel {
  EMAIL
  SMS
  PORTAL
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum CommStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNDER_REVIEW
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  DELETED
}

// ──────────────────────────────────────────────
// CORE MODELS
// ──────────────────────────────────────────────

model Business {
  id              String   @id @default(uuid())
  name            String
  legalName       String?
  email           String?
  phone           String?
  address         String?  @db.Text
  city            String?
  country         String?
  timezone        String   @default("Asia/Karachi")
  defaultCurrency String   @default("PKR")
  logoUrl         String?
  website         String?
  taxId           String?
  settingsJson    Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches       Branch[]
  users          User[]
  roles          Role[]
  permissions    Permission[]
  leads          Lead[]
  clients        Client[]
  applicants     Applicant[]
  countries      Country[]
  visaTypes      VisaType[]
  workflowTemplates WorkflowTemplate[]
  cases          Case[]
  requirementTemplates RequirementTemplate[]
  documents      Document[]
  tasks          Task[]
  appointments   Appointment[]
  messageTemplates MessageTemplate[]
  communications Communication[]
  services       Service[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  expenses       Expense[]
  knowledgeArticles KnowledgeArticle[]
  aiConversations AiConversation[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  backupRecords  BackupRecord[]
  historicalVisaImports HistoricalVisaImport[]

  @@map("businesses")
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String?  @db.Text
  phone      String?
  email      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users    User[]
  cases    Case[]

  @@index([businessId])
  @@map("branches")
}

model User {
  id                    String    @id @default(uuid())
  businessId            String
  branchId              String?
  email                 String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  avatarUrl             String?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  resetToken            String?
  resetTokenExpiresAt   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles      UserRole[]
  assignedLeads  Lead[]         @relation("LeadAssignedTo")
  createdLeads   Lead[]         @relation("LeadCreatedBy")
  assignedCases  Case[]         @relation("CaseAssignedTo")
  createdCases   Case[]         @relation("CaseCreatedBy")
  caseEvents     CaseEvent[]
  checklistReviews CaseChecklistItem[] @relation("ChecklistReviewer")
  documentUploads  Document[]     @relation("DocumentUploadedBy")
  documentVersionUploads DocumentVersion[] @relation("VersionUploadedBy")
  documentVersionReviews DocumentVersion[] @relation("VersionReviewedBy")
  assignedTasks  Task[]         @relation("TaskAssignedTo")
  createdTasks   Task[]         @relation("TaskCreatedBy")
  appointments   Appointment[]
  communications Communication[]
  quotations     Quotation[]
  invoicesCreated Invoice[]
  paymentsRecorded Payment[]
  refundsProcessed Refund[]
  expenses       Expense[]
  knowledgeArticles KnowledgeArticle[]
  aiConversations AiConversation[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([businessId])
  @@index([branchId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([businessId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  businessId  String
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([businessId, module, action])
  @@index([businessId])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ──────────────────────────────────────────────
// CRM MODELS
// ──────────────────────────────────────────────

model Lead {
  id                String     @id @default(uuid())
  businessId        String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  source            String?
  campaign          String?
  stage             LeadStage  @default(NEW)
  countryId         String?
  visaTypeId        String?
  travelDate        DateTime?
  purpose           String?
  budget            Decimal?   @db.Decimal(12, 2)
  preferredLanguage String?    @default("en")
  contactMethod     String?
  consentGiven      Boolean    @default(false)
  notes             String?    @db.Text
  lostReason        String?
  nextFollowUpAt    DateTime?
  assignedToId      String?
  createdById       String?
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country     Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  visaType    VisaType? @relation(fields: [visaTypeId], references: [id], onDelete: SetNull)
  assignedTo  User?     @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([stage])
  @@index([assignedToId])
  @@map("leads")
}

model Client {
  id                String        @id @default(uuid())
  businessId        String
  clientType        ClientType    @default(INDIVIDUAL)
  firstName         String
  lastName          String
  companyName       String?
  email             String?
  phone             String?
  alternatePhone    String?
  address           String?       @db.Text
  city              String?
  country           String?
  preferredLanguage String?       @default("en")
  consentStatus     ConsentStatus @default(PENDING)
  consentDate       DateTime?
  consentMethod     String?
  tags              String?
  notes             String?       @db.Text
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applicants Applicant[]
  cases      Case[]
  quotations Quotation[]
  invoices   Invoice[]
  communications Communication[]

  @@index([businessId])
  @@map("clients")
}

model Applicant {
  id             String    @id @default(uuid())
  businessId     String
  clientId       String
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  placeOfBirth   String?
  nationality    String?
  gender         String?
  passportNumber String?
  passportIssueDate   DateTime?
  passportExpiryDate  DateTime?
  passportIssuePlace  String?
  nationalIdNumber    String?
  email          String?
  phone          String?
  address        String?   @db.Text
  notes          String?   @db.Text
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cases          Case[]
  caseApplicants CaseApplicant[]
  documents      Document[]

  @@index([businessId])
  @@index([clientId])
  @@map("applicants")
}

// ──────────────────────────────────────────────
// REFERENCE MODELS
// ──────────────────────────────────────────────

model Country {
  id         String   @id @default(uuid())
  businessId String
  name       String
  code       String
  flagUrl    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visaTypes         VisaType[]
  leads             Lead[]
  cases             Case[]
  workflowTemplates WorkflowTemplate[]
  requirementTemplates RequirementTemplate[]
  knowledgeArticles KnowledgeArticle[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("countries")
}

model VisaType {
  id          String   @id @default(uuid())
  businessId  String
  countryId   String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  leads             Lead[]
  cases             Case[]
  workflowTemplates WorkflowTemplate[]
  requirementTemplates RequirementTemplate[]

  @@index([businessId])
  @@index([countryId])
  @@map("visa_types")
}

// ──────────────────────────────────────────────
// WORKFLOW MODELS
// ──────────────────────────────────────────────

model WorkflowTemplate {
  id          String   @id @default(uuid())
  businessId  String
  countryId   String?
  visaTypeId  String?
  name        String
  description String?  @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country    Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  visaType   VisaType?         @relation(fields: [visaTypeId], references: [id], onDelete: SetNull)
  stages     WorkflowStage[]
  cases      Case[]

  @@index([businessId])
  @@map("workflow_templates")
}

model WorkflowStage {
  id                 String   @id @default(uuid())
  workflowTemplateId String
  name               String
  description        String?
  orderIndex         Int
  isClientVisible    Boolean  @default(false)
  clientVisibleLabel String?
  requiredFields     Json?
  slaHours           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workflowTemplate    WorkflowTemplate      @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  transitionsFrom     WorkflowTransition[]   @relation("TransitionFrom")
  transitionsTo       WorkflowTransition[]   @relation("TransitionTo")

  @@index([workflowTemplateId])
  @@map("workflow_stages")
}

model WorkflowTransition {
  id              String   @id @default(uuid())
  fromStageId     String
  toStageId       String
  name            String?
  requiresChecklist Boolean @default(false)
  requiresPayment   Boolean @default(false)
  requiresApproval  Boolean @default(false)
  mandatoryReason   Boolean @default(false)
  createdAt       DateTime @default(now())

  fromStage WorkflowStage @relation("TransitionFrom", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage   WorkflowStage @relation("TransitionTo", fields: [toStageId], references: [id], onDelete: Cascade)

  @@map("workflow_transitions")
}

model Case {
  id                   String       @id @default(uuid())
  businessId           String
  branchId             String?
  clientId             String
  applicantId          String
  countryId            String
  visaTypeId           String
  workflowTemplateId   String?
  reference            String       @unique
  status               CaseStatus   @default(ENQUIRY)
  outcome              CaseOutcome  @default(PENDING)
  purpose              String?
  travelDate           DateTime?
  intendedArrivalDate  DateTime?
  intendedDepartureDate DateTime?
  appointmentDate      DateTime?
  plannedSubmissionDate DateTime?
  actualSubmissionDate DateTime?
  decisionDate         DateTime?
  outcomeNotes         String?      @db.Text
  refusalReason        String?      @db.Text
  internalNotes        String?      @db.Text
  clientVisibleNotes   String?      @db.Text
  assignedToId         String?
  createdById          String?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  applicant         Applicant          @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  visaType          VisaType           @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)
  workflowTemplate  WorkflowTemplate?  @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  assignedTo        User?              @relation("CaseAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  caseApplicants    CaseApplicant[]
  caseEvents        CaseEvent[]
  checklistItems    CaseChecklistItem[]
  documents         Document[]
  tasks             Task[]
  appointments      Appointment[]
  communications    Communication[]
  quotations        Quotation[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]

  @@index([businessId])
  @@index([clientId])
  @@index([applicantId])
  @@index([assignedToId])
  @@index([status])
  @@map("cases")
}

model CaseApplicant {
  id           String   @id @default(uuid())
  caseId       String
  applicantId  String
  relationship String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([caseId, applicantId])
  @@map("case_applicants")
}

model CaseEvent {
  id          String   @id @default(uuid())
  caseId      String
  userId      String?
  eventType   String
  title       String
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  case Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("case_events")
}

// ──────────────────────────────────────────────
// DOCUMENT MODELS
// ──────────────────────────────────────────────

model RequirementTemplate {
  id              String            @id @default(uuid())
  businessId      String
  countryId       String?
  visaTypeId      String?
  name            String
  description     String?           @db.Text
  status          RequirementStatus @default(MANDATORY)
  acceptableFormats String?
  maxSizeMb       Int?
  expiryRule      String?
  sourceUrl       String?
  effectiveDate   DateTime?
  lastVerifiedDate DateTime?
  nextReviewDate  DateTime?
  version         Int               @default(1)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country        Country?            @relation(fields: [countryId], references: [id], onDelete: SetNull)
  visaType       VisaType?           @relation(fields: [visaTypeId], references: [id], onDelete: SetNull)
  checklistItems CaseChecklistItem[]

  @@index([businessId])
  @@map("requirement_templates")
}

model CaseChecklistItem {
  id                    String              @id @default(uuid())
  caseId                String
  requirementTemplateId String?
  title                 String
  description           String?             @db.Text
  status                ChecklistItemStatus @default(NOT_REQUESTED)
  dueAt                 DateTime?
  reviewerId            String?
  decisionReason        String?             @db.Text
  decisionAt            DateTime?
  responsibleParty      String?
  orderIndex            Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirementTemplate RequirementTemplate? @relation(fields: [requirementTemplateId], references: [id], onDelete: SetNull)
  reviewer            User?                @relation("ChecklistReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("case_checklist_items")
}

model Document {
  id            String         @id @default(uuid())
  businessId    String
  caseId        String?
  applicantId   String?
  title         String
  description   String?
  storageKey    String
  mimeType      String
  sizeBytes     Int
  fileHash      String?
  sensitivity   DocSensitivity @default(NORMAL)
  status        DocStatus      @default(UPLOADED)
  uploadedById  String?
  tags          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  case        Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  applicant   Applicant?        @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  uploadedBy  User?             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  versions    DocumentVersion[]

  @@index([businessId])
  @@index([caseId])
  @@index([applicantId])
  @@map("documents")
}

model DocumentVersion {
  id            String       @id @default(uuid())
  documentId    String
  versionNumber Int          @default(1)
  storageKey    String
  mimeType      String
  sizeBytes     Int
  fileHash      String?
  reviewStatus  ReviewStatus @default(PENDING)
  reviewNotes   String?      @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  uploadedById  String?
  createdAt     DateTime     @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("VersionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("VersionUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("document_versions")
}

// ──────────────────────────────────────────────
// TASK MODELS
// ──────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid())
  businessId    String
  caseId        String?
  title         String
  description   String?    @db.Text
  taskType      TaskType   @default(INTERNAL)
  priority      Priority   @default(MEDIUM)
  status        TaskStatus @default(PENDING)
  dueAt         DateTime?
  completedAt   DateTime?
  assignedToId  String?
  createdById   String?
  linkedEntityType String?
  linkedEntityId   String?
  instructions  String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([caseId])
  @@index([assignedToId])
  @@index([status])
  @@map("tasks")
}

model Appointment {
  id              String            @id @default(uuid())
  businessId      String
  caseId          String?
  title           String
  description     String?           @db.Text
  appointmentType String?
  status          AppointmentStatus @default(SCHEDULED)
  startTime       DateTime
  endTime         DateTime
  location        String?
  meetingLink     String?
  attendees       Json?
  reminders       Json?
  outcome         String?           @db.Text
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  case     Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([caseId])
  @@map("appointments")
}

// ──────────────────────────────────────────────
// COMMUNICATION MODELS
// ──────────────────────────────────────────────

model MessageTemplate {
  id         String   @id @default(uuid())
  businessId String
  name       String
  subject    String?
  body       String   @db.Text
  channel    Channel  @default(EMAIL)
  language   String   @default("en")
  variables  Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("message_templates")
}

model Communication {
  id          String     @id @default(uuid())
  businessId  String
  caseId      String?
  clientId    String?
  channel     Channel    @default(EMAIL)
  direction   Direction  @default(OUTBOUND)
  status      CommStatus @default(DRAFT)
  subject     String?
  body        String     @db.Text
  recipient   String?
  sender      String?
  metadata    Json?
  sentAt      DateTime?
  userId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  case     Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([caseId])
  @@index([clientId])
  @@map("communications")
}

// ──────────────────────────────────────────────
// FINANCE MODELS
// ──────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?  @db.Text
  baseFee     Decimal  @db.Decimal(12, 2)
  currency    String   @default("PKR")
  taxRate     Decimal? @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]

  @@index([businessId])
  @@map("services")
}

model Quotation {
  id           String          @id @default(uuid())
  businessId   String
  clientId     String
  caseId       String?
  reference    String          @unique
  status       QuotationStatus @default(DRAFT)
  validUntil   DateTime?
  subtotal     Decimal         @db.Decimal(12, 2) @default(0)
  taxAmount    Decimal         @db.Decimal(12, 2) @default(0)
  totalAmount  Decimal         @db.Decimal(12, 2) @default(0)
  discount     Decimal         @db.Decimal(12, 2) @default(0)
  currency     String          @default("PKR")
  terms        String?         @db.Text
  notes        String?         @db.Text
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case      Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     QuotationItem[]

  @@index([businessId])
  @@index([clientId])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id            String        @id @default(uuid())
  businessId    String
  clientId      String
  caseId        String?
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2) @default(0)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  paidAmount    Decimal       @db.Decimal(12, 2) @default(0)
  currency      String        @default("PKR")
  snapshotData  Json?
  notes         String?       @db.Text
  terms         String?       @db.Text
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case      Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([businessId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(uuid())
  invoiceId     String
  serviceId     String?
  description   String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(12, 2)
  totalPrice    Decimal @db.Decimal(12, 2)
  isPassThrough Boolean @default(false)
  createdAt     DateTime @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  businessId    String
  invoiceId     String?
  caseId        String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("PKR")
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  reference     String?
  transactionId String?
  notes         String?       @db.Text
  paidAt        DateTime?
  recordedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  recordedBy User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  refunds    Refund[]

  @@index([businessId])
  @@index([invoiceId])
  @@map("payments")
}

model Refund {
  id           String       @id @default(uuid())
  businessId   String
  paymentId    String
  amount       Decimal      @db.Decimal(12, 2)
  reason       String?      @db.Text
  status       RefundStatus @default(REQUESTED)
  processedAt  DateTime?
  processedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processedBy User?    @relation(fields: [processedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([paymentId])
  @@map("refunds")
}

model Expense {
  id          String   @id @default(uuid())
  businessId  String
  caseId      String?
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PKR")
  date        DateTime
  receipt     String?
  vendor      String?
  notes       String?  @db.Text
  recordedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  recordedBy User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([caseId])
  @@map("expenses")
}

// ──────────────────────────────────────────────
// KNOWLEDGE MODELS
// ──────────────────────────────────────────────

model KnowledgeArticle {
  id              String        @id @default(uuid())
  businessId      String
  countryId       String?
  title           String
  content         String        @db.LongText
  category        String?
  tags            String?
  status          ArticleStatus @default(DRAFT)
  sourceUrl       String?
  effectiveDate   DateTime?
  lastVerifiedDate DateTime?
  nextReviewDate  DateTime?
  version         Int           @default(1)
  authorId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country  Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("knowledge_articles")
}

// ──────────────────────────────────────────────
// AI MODELS
// ──────────────────────────────────────────────

model AiConversation {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  title      String?
  context    Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([businessId])
  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id               String   @id @default(uuid())
  conversationId   String
  role             AiRole
  content          String   @db.LongText
  toolCalls        Json?
  toolResults      Json?
  model            String?
  provider         String?
  tokensUsed       Int?
  processingTimeMs Int?
  createdAt        DateTime @default(now())

  conversation AiConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposals    AiActionProposal[]

  @@index([conversationId])
  @@map("ai_messages")
}

model AiActionProposal {
  id          String         @id @default(uuid())
  businessId  String
  messageId   String?
  action      String
  targetEntity String
  targetId    String?
  beforeData  Json?
  afterData   Json?
  reason      String?        @db.Text
  status      ProposalStatus @default(PENDING)
  expiresAt   DateTime?
  approvedById String?
  approvedAt  DateTime?
  executedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  message AiMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status])
  @@map("ai_action_proposals")
}

// ──────────────────────────────────────────────
// PLATFORM MODELS
// ──────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  userId      String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid())
  businessId  String
  userId      String
  title       String
  message     String   @db.Text
  type        String?
  linkUrl     String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model BackupRecord {
  id          String       @id @default(uuid())
  businessId  String
  filename    String
  sizeBytes   Int?
  status      BackupStatus @default(IN_PROGRESS)
  type        String       @default("full")
  storagePath String?
  checksum    String?
  notes       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("backup_records")
}

model HistoricalVisaImport {
  id                     String   @id @default(uuid())
  businessId             String
  sourceFile             String
  snapshotDate           DateTime?
  recordCount            Int
  uniquePassportCount    Int
  repeatedPassportEntries Int
  sheetCount             Int
  statusCounts           Json
  importedAt             DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceFile])
  @@index([businessId, importedAt])
  @@map("historical_visa_imports")
}
