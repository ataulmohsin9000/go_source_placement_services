# Database
DATABASE_URL="mysql://root:password@localhost:3307/visa_crm"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Cookie
COOKIE_SECRET="change-this-to-a-secure-random-string-in-production"
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:5173

# File Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE=10485760

# AI (optional)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gosource.com
